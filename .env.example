# Any OpenAI-compatible endpoint works (OpenAI / Bailian-compatible / OpenRouter etc.)
OPENAI_API_KEY=your-key
OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-5-mini
JUDGE_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small

DATABASE_URL=postgres://postgres:postgres@localhost:5433/agent_eval
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# 1 = enable semantic scorer when a task has expected.referenceAnswer
ENABLE_SEMANTIC_SCORER=0
# 1 = enable LLM judge when a task requests llmJudge
ENABLE_LLM_JUDGE=1

# ---------------- OpenTelemetry + Langfuse ----------------
# 0: completely disable telemetry. 1: enable telemetry.
TELEMETRY_ENABLED=0
# langfuse = OTel SDK -> LangfuseSpanProcessor -> Langfuse (easiest first run)
# otlp     = OTel SDK -> OTLP Collector -> Langfuse/Tempo/etc. (production-style)
# off      = do not create an exporter
TELEMETRY_EXPORTER=langfuse
OTEL_SERVICE_NAME=agent-eval-platform
OTEL_LOG_LEVEL=INFO

# Sending task/code/model content can contain sensitive data. Keep 0 in production unless reviewed.
TELEMETRY_CAPTURE_CONTENT=0

# Direct Langfuse mode
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# OTLP/Collector mode (host app -> local Collector)
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Collector -> Langfuse mode. LANGFUSE_OTEL_AUTH must literally be: Basic <base64(pk:sk)>
LANGFUSE_OTEL_ENDPOINT=https://cloud.langfuse.com/api/public/otel
LANGFUSE_OTEL_AUTH=

# Optional dashboard link. Langfuse trace URL needs the Langfuse project id.
NEXT_PUBLIC_LANGFUSE_BASE_URL=https://cloud.langfuse.com
NEXT_PUBLIC_LANGFUSE_PROJECT_ID=
